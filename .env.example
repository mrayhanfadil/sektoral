# Names only, no values: copy to .env and fill in. .env is gitignored; this file is not.
#
# compose reads it via env_file, and the app prefers real environment variables over the host files it would
# otherwise load (~/.config/sectors-be/env), so inside a container these are the source of truth.

# Sectors v2 licensed dataset. Without it the data endpoints report the missing key instead of guessing.
SECTORS_API_KEY=

MINIMAX_API_KEY=
# Optional web news context for the analyst agent (context only, never numbers).
# One or more keys, comma separated; requests rotate round-robin across them.
TAVILY_API_KEYS=
# Web approval of a report's Forecast Plan (app/assumption_review.py). Leave
# empty to switch it off; the CLI approval works without it. Use a long random
# value and share it only with reviewers.
SECTORAL_REVIEW_TOKEN=

# Live research runs from the web app. compose.yaml sets SECTORAL_LIVE_RUNS=token,
# so only someone with this token starts a live (paid) run; everyone else
# replays stored runs. Leave empty to refuse all live runs from the web.
SECTORAL_RUN_TOKEN=
