# Names only, no values: copy to .env and fill in. .env is gitignored; this file is not.
#
# compose reads it via env_file, and the app prefers real environment variables over .env,
# so inside a container these are the source of truth.

# Sectors v2 API key. Only the offline snapshot tools (app/sectors.py, app/topup.py) call
# Sectors upstream to extend data/sectors_cache.db; research runs read that snapshot.
SECTORS_API_KEY=

# LLM for the agents (any OpenAI-compatible chat endpoint). Uncomment to override the defaults: MiniMax at
# https://api.minimax.io/v1 with model MiniMax-M3. MINIMAX_API_KEY is accepted as the key.
SEKTORAL_LLM_API_KEY=
# SEKTORAL_LLM_BASE_URL=
# SEKTORAL_LLM_MODEL=
MINIMAX_API_KEY=

# Optional web news context for the analyst agent (context only, never numbers).
# One or more keys, comma separated; requests rotate round-robin across them.
TAVILY_API_KEYS=

# Authenticated reviewers for frozen Publication Bundles. Each entry maps a
# reviewer identity/role to the SHA-256 digest of a long random token; never put
# the raw token in this file. Valid roles: analyst, reviewer, compliance.
SECTORAL_REVIEWERS=[]

# Live research runs from the web app: "open" (compose default, localhost only) lets
# anyone start one; "token" lets only SECTORAL_RUN_TOKEN start a live (paid) run while
# everyone else replays stored runs. Use "token" for any public deployment.
SECTORAL_LIVE_RUNS=
SECTORAL_RUN_TOKEN=

# Reviewer or compliance token for `python -m app.publication_monitor --apply`.
SECTORAL_MONITOR_TOKEN=
# Set to 0 to require human review before a distributable report is published.
# SECTORAL_AUTO_PUBLISH=

# Optional overrides; leave commented for the defaults (an empty value replaces a default): host/port, the run and report
# folders, the SQLite store path, and PDF export (1 to render PDFs).
# SECTORAL_HOST=
# SECTORAL_PORT=
# SECTORAL_OUT=
# SECTORAL_REPORTS=
# SECTORAL_DB=
# SECTORAL_PDF=
